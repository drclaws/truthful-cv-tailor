# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Local environment
.venv/
venv/
env/
.env
.env.*
!.env.example

# Python cache and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local AI-assistant and agent settings may contain machine-specific behavior.
.codex/
.claude/
.cursor/
.continue/
.windsurf/
.aider*
.gemini/
.roo/
.mcp.json

# User's harness-native local agent rules file: real paths and personal data.
# Covers CLAUDE.local.md and every harness equivalent.
*.local.md

# Generated CV outputs and validator artifacts.
outputs/*
!outputs/.gitkeep

# The predecessor structure's data/ directory is gone from this repository: the
# knowledge bank lives in outputs/knowledge-bank/ and job material inside its run.
# The rule stays as a guard — a working tree upgraded from the old layout still
# holds the real bank and real job dossiers there, and they must never be committed.
data/

# LaTeX/render byproducts, in case they are created outside outputs/.
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Generated exports
*.pdf
*.docx
